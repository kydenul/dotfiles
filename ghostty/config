# ============================================================================
# Ghostty Configuration
# https://ghostty.org/docs/config/reference
# ============================================================================

# UI (Theme & Font & Window)
# Gruvbox Dark / Catppuccin Mocha
theme = Catppuccin Mocha
# auto / ghostty
window-theme = auto

keybind = global:ctrl+shift+grave_accent=toggle_quick_terminal
quick-terminal-position = top

background-image = ~/.config/images/alone.jpg
background-image-opacity = 0.1
background-image-fit = cover 

font-family = "Maple Mono NF CN"
font-feature = -calt
font-size = 16
font-thicken = true
background-opacity = 0.85 
# macOS 26+ native glass: macos-glass-regular / macos-glass-clear (or an integer radius, e.g. 36)
background-blur = macos-glass-regular
window-save-state = always
window-padding-y = 0
window-padding-x = 0

# Inherit working directory (new tabs / splits)
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Quit after the last window is closed
quit-after-last-window-closed = true

# Mouse
copy-on-select = clipboard
mouse-hide-while-typing = true
macos-option-as-alt = true

# macos-titlebar-style: native / tabs / transparent
macos-titlebar-style = hidden 

# Buffer size in bytes: 256 MB
scrollback-limit-bytes = 256000000

# Clipboard
clipboard-write = allow
clipboard-read = ask
