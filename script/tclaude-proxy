#!/usr/bin/env bash
# ============================================================================
# tclaude-proxy — 复用 tclaude / tcodex 本地网关给 Claude Code / pi / cc-switch
# Docs: ~/.dotfiles/docs/tclaude-proxy.md
#
# Usage:
#   tclaude-proxy start [tclaude|tcodex]  启动或检查网关（默认两者）
#   tclaude-proxy agent install|status|uninstall
#                                  管理开机自启及每 5 分钟的网关检查
#   tclaude-proxy logs              查看两个网关和守护日志（隐藏凭据）
#   tclaude-proxy status [tclaude|tcodex] 查看网关状态（默认两者）
#   tclaude-proxy port             仅输出端口（供脚本消费）
#   tclaude-proxy url [tcodex]     仅输出 URL（默认 tclaude）
#   tclaude-proxy env              输出 export 语句，配合 eval 使用
#   tclaude-proxy ensure [tclaude|tcodex] 确保网关运行（默认两者）
#   tclaude-proxy doctor           完整体检
#   tclaude-proxy sync-ccswitch [claude|pi]
#                                  预览端口同步改动（只读）；省略 app 则两者都处理
#   tclaude-proxy sync-ccswitch [claude|pi] --apply
#                                  真正写入 ~/.claude/settings.json 和/或
#                                  ~/.pi/agent/models.json（含 tclaude / tcodex）
# END-USAGE
# ============================================================================

set -euo pipefail

PROXY_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROXY_BIN="$PROXY_SCRIPT_DIR/tclaude-proxy"
PROXY_LIB_DIR="$PROXY_SCRIPT_DIR/lib/tclaude-proxy"

# shellcheck source=lib/tclaude-proxy/cli.sh
source "$PROXY_LIB_DIR/cli.sh"
main "$@"
