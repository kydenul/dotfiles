#!/usr/bin/env bash
# ============================================================================
# open-file-ref — 打开 "path/to/file:line[:col]" 格式的文件引用
#
# 由 kitty 的 open-actions.conf 调用：kitty.conf 里的 detect_url_regex 会把
# 编译器输出中的文件引用识别为链接，点击后通过 launch --type=background
# 启动本脚本。也可手动调用：
#
#     open-file-ref src/foo.c:42
#     open-file-ref ~/proj/a.go:10:5
#
# 相对路径按 launch 继承的 cwd 解析；打开方式：新开一个 kitty OS window。
# ============================================================================

set -euo pipefail

# GUI 方式启动的 kitty，其子进程 PATH 里可能没有 /opt/homebrew/bin（nvim 在那里）
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

die() {
    printf 'open-file-ref: %s\n' "$*" >&2
    exit 1
}

[ $# -eq 1 ] || die "usage: open-file-ref <file:line[:col]>"

ref=$1
case $ref in
    *:*:*) file=${ref%%:*}; line=${ref#*:}; line=${line%%:*}; col=${ref##*:} ;;
    *:*)   file=${ref%%:*}; line=${ref##*:}; col=1 ;;
    *)     die "格式错误（应为 file:line[:col]）: $ref" ;;
esac
case $line$col in *[!0-9]*) die "格式错误（应为 file:line[:col]）: $ref" ;; esac
[ -n "$line" ] && [ -n "$col" ] || die "格式错误（应为 file:line[:col]）: $ref"

# 展开 ~ 前缀
case $file in '~'*) file=$HOME${file#\~} ;; esac

[ -f "$file" ] || die "file not found: $ref (cwd: $PWD)"

# 防止以 - 开头的文件名被 nvim 当作参数
case $file in -*) file=./$file ;; esac

exec kitty nvim "+call cursor($line,$col)" "$file"
